ATOMS_DATABASE_URL=sqlite:////data/platform.db
ATOMS_BLOB_DIRECTORY=/data/blobs
ATOMS_PUBLIC_ORIGIN=http://app.preview.localhost:18080
# For the explicitly exposed Chengdu IP test entrance only, replace the line
# above with http://8.137.197.104:18080 and set ATOMS_PUBLIC_IP_TEST_MODE=true.
# Preview still requires separate per-project hosts; this does not expose it.
ATOMS_PREVIEW_ORIGIN=http://preview.localhost:18001
ATOMS_HOST=127.0.0.1
ATOMS_PORT=8000
ATOMS_PREVIEW_BIND_HOST=127.0.0.1
ATOMS_PREVIEW_BIND_PORT=8132
ATOMS_MODEL_PROVIDER=aliyun_token_plan
ATOMS_MODEL_NAME=qwen3.7-plus
ATOMS_MODEL_SECRET_NAME=OPS_TOKEN_PLAN_API_KEY
ATOMS_MODEL_TIMEOUT_SECONDS=600
ATOMS_MODEL_INPUT_CREDITS_PER_MILLION=1000
ATOMS_MODEL_OUTPUT_CREDITS_PER_MILLION=4000
ATOMS_INITIAL_BUILD_CREDITS=100000
ATOMS_BUILD_BACKEND=docker
ATOMS_AUTOMATIC_INFRASTRUCTURE_ENABLED=false
# Optional private-only widget exercise. Use only Cloudflare's official test keys
# with ATOMS_PRIVATE_TEST_MODE=true and a restricted local mail outbox.
# ATOMS_CAPTCHA_PROVIDER=turnstile
# ATOMS_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# ATOMS_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
