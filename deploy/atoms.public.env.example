# Public deployment template. Copy to /etc/atoms-demo/atoms.env (0600).
# Keep API, preview runtime and TLS permission service on loopback.
ATOMS_DATABASE_URL=sqlite:////var/lib/atoms-demo/platform.db
ATOMS_BLOB_DIRECTORY=/var/lib/atoms-demo/blobs
ATOMS_PUBLIC_ORIGIN=https://app.bangbangsanquan.cloud
ATOMS_PREVIEW_ORIGIN=https://preview.bangbangsanquan.cloud
ATOMS_HOST=127.0.0.1
ATOMS_PORT=8000
ATOMS_PREVIEW_BIND_HOST=127.0.0.1
ATOMS_PREVIEW_BIND_PORT=8132
ATOMS_TLS_PERMISSION_PORT=8133
ATOMS_MODEL_PROVIDER=aliyun_token_plan
ATOMS_MODEL_NAME=qwen3.7-plus
ATOMS_MODEL_SECRET_NAME=OPS_TOKEN_PLAN_API_KEY
ATOMS_MODEL_INPUT_CREDITS_PER_MILLION=1000
ATOMS_MODEL_OUTPUT_CREDITS_PER_MILLION=4000
ATOMS_INITIAL_BUILD_CREDITS=100000
ATOMS_BUILD_BACKEND=docker
ATOMS_AUTOMATIC_INFRASTRUCTURE_ENABLED=false
