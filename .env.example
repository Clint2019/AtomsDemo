# Copy values into the process environment; this file is not loaded automatically.
ATOMS_DATABASE_URL=sqlite:///runtime-data/platform.db
ATOMS_BLOB_DIRECTORY=runtime-data/blobs
# Use a same-site but separate origin from each project preview host.
ATOMS_PUBLIC_ORIGIN=http://app.preview.localhost:5173
ATOMS_PREVIEW_ORIGIN=http://preview.localhost:8001
# For public HTTPS, set a separate local loopback port behind a TLS reverse proxy.
# ATOMS_PREVIEW_BIND_HOST=127.0.0.1
# ATOMS_PREVIEW_BIND_PORT=8132
# Token Plan personal adapter (disabled when provider or local key is absent).
ATOMS_MODEL_PROVIDER=aliyun_token_plan
ATOMS_MODEL_NAME=qwen3.7-plus
ATOMS_MODEL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Name of a local process environment variable containing the key, not the key itself.
ATOMS_MODEL_SECRET_NAME=OPS_TOKEN_PLAN_API_KEY
ATOMS_MODEL_MAX_OUTPUT_TOKENS=8192
ATOMS_MODEL_INPUT_CREDITS_PER_MILLION=1000
ATOMS_MODEL_OUTPUT_CREDITS_PER_MILLION=4000
ATOMS_INITIAL_BUILD_CREDITS=100000
ATOMS_TASK_TIMEOUT_SECONDS=180
# Requires a prepared atoms-react-vite:v1 image on the selected Docker engine.
ATOMS_BUILD_BACKEND=docker
# Optional verified SSH host alias. Remote mode needs local ssh, not local Docker CLI.
ATOMS_BUILD_DOCKER_HOST=
ATOMS_MAX_REPAIRS=2
ATOMS_AUTOMATIC_INFRASTRUCTURE_ENABLED=false
ATOMS_HOST=127.0.0.1
ATOMS_PORT=8000
ATOMS_MAX_REQUEST_BYTES=1048576
ATOMS_MAX_BLOB_BYTES=20971520
ATOMS_STORAGE_QUOTA_BYTES=1073741824
ATOMS_QUEUE_LEASE_SECONDS=60
ATOMS_DEPLOYMENT_VERIFY_HOSTS=
# Only for explicit loopback + .localhost SSH-only staging. Captured links are not emailed.
# ATOMS_PRIVATE_TEST_MODE=true
# ATOMS_PRIVATE_MAIL_OUTBOX=/absolute/private/data/private-mail/outbox.jsonl
# Optional Cloudflare Turnstile. In private test mode, use only Cloudflare's official
# test keys; production keys require private test mode to be off. Never commit secrets.
# ATOMS_CAPTCHA_PROVIDER=turnstile
# ATOMS_TURNSTILE_SITE_KEY=
# ATOMS_TURNSTILE_SECRET_KEY=
# Registration also needs a mail delivery provider outside private local capture.
# Generate a Fernet key locally; never commit its value.
ATOMS_SECRET_ENCRYPTION_KEY=
